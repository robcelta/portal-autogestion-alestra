<%# Búsqueda — Sin resultados (empty state)
    Figma node: 725:29029
    Layout: alestra_rails_ui/portal (sidebar auto-rendered)
    Renders only the <main> content area. %>

<% content_for :topbar_right do %>
  <button type="button" class="alestra-notification-cta" aria-label="Notificaciones">
    <%= alestra_icon("notifications") %>
  </button>
<% end %>

<%# ── Page heading ──────────────────────────────────────────────────────── %>
<div style="margin-bottom: 1.5rem;">
  <h1 class="alestra-page-title">Resultados búsqueda</h1>
</div>

<%# ── Search banner ─────────────────────────────────────────────────────── %>
<div style="background: #ac4fc6; border-radius: 13px; padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem;">
  <div style="color: #fff; flex: 0 0 auto;">
    <p style="font-size: 1.125rem; font-weight: 700; margin: 0 0 0.25rem;">¿No encuentras lo que estás buscando?</p>
    <p style="font-size: 1rem; font-weight: 400; margin: 0;">Utiliza nuestra herramienta de búsqueda.</p>
  </div>
  <div class="alestra-filter__search" style="flex: 1; max-width: 495px;">
    <span class="alestra-filter__search-icon">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
      </svg>
    </span>
    <input type="search"
           class="alestra-filter__search-input"
           placeholder="Buscar..."
           value="<%= params[:q].to_s %>">
  </div>
</div>

<%# ── Results meta + back CTA ───────────────────────────────────────────── %>
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; gap: 1rem;">
  <div style="font-size: 1rem; color: var(--alestra-color-text); line-height: 1.6;">
    <p style="margin: 0;">
      <strong>Parámetro de búsqueda:</strong>
      <%= params[:q].present? ? h(params[:q]) : "Pagos" %>
    </p>
    <p style="margin: 0; font-weight: 300;">Mostrando 0 de 0 resultados</p>
  </div>
  <a href="<%= dashboard_path %>"
     class="alestra-btn-primary alestra-btn--small"
     style="background: #ac4fc6; border-color: #ac4fc6; white-space: nowrap; flex-shrink: 0;">
    Volver a Inicio
  </a>
</div>

<%# ── Empty state ───────────────────────────────────────────────────────── %>
<div style="max-width: 740px;">
  <h2 class="alestra-page-title" style="margin-bottom: 1rem; font-size: 2rem;">
    ¡Ups! Parece que no pudimos encontrar lo que estás buscando.
  </h2>
  <p style="font-size: 1rem; font-weight: 400; color: var(--alestra-color-text); line-height: 1.6;">
    Ingresa un nuevo parámetro de búsqueda o utiliza el menú de la izquierda para navegar entre las páginas disponibles.
  </p>
</div>
