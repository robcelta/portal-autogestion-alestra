<% content_for :topbar_right do %>
  <a href="<%= gestion_root_path %>" class="alestra-btn-secondary alestra-btn--small">Volver a líneas</a>
<% end %>

<h1 class="alestra-page-title">Gestión de líneas y servicios</h1>
<turbo-frame id="modal_frame">
  <div class="alestra-modal-backdrop" data-controller="alestra--modal" data-alestra--modal-open-value="true">
    <div class="alestra-modal alestra-modal--sm alestra-modal--success" role="dialog" aria-modal="true">
      <div class="alestra-modal__icon alestra-modal__icon--success">✓</div>
      <div class="alestra-modal__header">
        <h2 class="alestra-modal__title">¡SIM reemplazada exitosamente!</h2>
      </div>
      <div class="alestra-modal__body">
        <p>El reemplazo de SIM para la línea <strong>618 382 5441</strong> fue procesado. La nueva SIM estará activa en los próximos minutos.</p>
      </div>
      <div class="alestra-modal__footer">
        <a href="<%= gestion_root_path %>" class="alestra-btn-primary">Aceptar</a>
      </div>
    </div>
  </div>
</turbo-frame>

