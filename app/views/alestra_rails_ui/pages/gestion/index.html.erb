<% content_for :topbar_right do %>
  <a href="<%= gestion_root_path %>" class="alestra-btn-primary alestra-btn--small">Gestión de líneas</a>
  <a href="<%= gestion_historia_path %>" class="alestra-btn-secondary alestra-btn--small">Historial de cambios</a>
<% end %>

<section class="alestra-gestion-header">
  <div class="alestra-gestion-header__text">
    <h1 class="alestra-page-title">Gestión de líneas y servicios</h1>
    <p class="alestra-gestion-header__desc">
      Administra todas las líneas y servicios de tu cuenta de forma rápida y segura.
    </p>
  </div>
</section>

<div class="alestra-card alestra-filter-bar" data-controller="alestra--filter">
  <div class="alestra-filter-bar__row">
    <span class="alestra-filter-bar__label">Filtrar por:</span>
    <select class="alestra-input alestra-input--sm" aria-label="Plan"><option>Plan</option></select>
    <select class="alestra-input alestra-input--sm" aria-label="Estado"><option>Estado</option></select>
    <select class="alestra-input alestra-input--sm" aria-label="Cuenta"><option>Cuenta</option></select>
    <div class="alestra-input-wrapper alestra-filter-bar__search">
      <input type="search" class="alestra-input" placeholder="Búsqueda por usuario, línea...">
    </div>
    <button type="button" class="alestra-btn-secondary alestra-btn--small" data-alestra--filter-target="toggle" data-action="alestra--filter#toggleAdvanced" aria-expanded="false">+ Más filtros</button>
  </div>
  <div class="alestra-filter-bar__advanced" data-alestra--filter-target="advanced" hidden>
    <span>Filtros rápidos:</span>
    <label class="alestra-filter-bar__quick"><input type="checkbox" value="active" data-alestra--filter-target="quick" data-action="change->alestra--filter#quickChanged"> Solo líneas activas</label>
    <label class="alestra-filter-bar__quick"><input type="checkbox" value="overuse" data-alestra--filter-target="quick" data-action="change->alestra--filter#quickChanged"> Solo líneas con sobreconsumo</label>
    <label class="alestra-filter-bar__quick"><input type="checkbox" value="blocked" data-alestra--filter-target="quick" data-action="change->alestra--filter#quickChanged"> Solo líneas bloqueadas</label>
  </div>
  <div class="alestra-filter-bar__applied" data-alestra--filter-target="applied" hidden>
    <span>Filtros aplicados:</span>
    <span class="alestra-filter-bar__tag" data-alestra--filter-target="tag" data-value="active">Solo líneas activas <button type="button" data-value="active" data-action="alestra--filter#remove" aria-label="Quitar filtro líneas activas">×</button></span>
    <span class="alestra-filter-bar__tag" data-alestra--filter-target="tag" data-value="overuse">Solo líneas con sobreconsumo <button type="button" data-value="overuse" data-action="alestra--filter#remove" aria-label="Quitar filtro sobreconsumo">×</button></span>
    <span class="alestra-filter-bar__tag" data-alestra--filter-target="tag" data-value="blocked">Solo líneas bloqueadas <button type="button" data-value="blocked" data-action="alestra--filter#remove" aria-label="Quitar filtro bloqueadas">×</button></span>
    <button type="button" class="alestra-filter-bar__clear" data-action="alestra--filter#clear">Limpiar filtros</button>
  </div>
  <div class="alestra-filter-bar__indicators">
    <span class="alestra-filter-bar__indicators-label">Indicadores:</span>
    <span class="alestra-badge alestra-badge--active">Datos disponibles</span>
    <span class="alestra-badge alestra-badge--warning">Consumo excedente</span>
    <span class="alestra-badge alestra-badge--inactive">Líneas bloqueadas</span>
  </div>
</div>

<div class="alestra-gestion-tabla">
  <p class="alestra-gestion-tabla__meta"><strong>Última actualización:</strong> 2 minutos.</p>

  <div class="alestra-table" data-controller="alestra--accordion">
    <div class="alestra-table__header alestra-gestion-table-header">
      <span class="alestra-table__cell"># de línea</span>
      <span class="alestra-table__cell alestra-table__cell--sm">Estatus</span>
      <span class="alestra-table__cell">Usuario</span>
      <span class="alestra-table__cell">Tipo de plan</span>
      <span class="alestra-table__cell">% de consumo</span>
      <span class="alestra-table__cell">Capacidad total</span>
      <span class="alestra-table__cell alestra-table__cell--sm"></span>
    </div>

    <% 8.times do |i| %>
      <div class="alestra-accordion__item" data-alestra--accordion-target="item">
        <button class="alestra-table__row alestra-accordion__trigger"
                data-action="click->alestra--accordion#toggle"
                style="width:100%;display:contents;">
          <span class="alestra-table__cell">618 382 5441</span>
          <span class="alestra-table__cell alestra-table__cell--sm">
            <span class="alestra-badge alestra-badge--active">Activo</span>
          </span>
          <span class="alestra-table__cell">Jon Snow</span>
          <span class="alestra-table__cell">Cobertura Completa 3.5 GB_Control</span>
          <span class="alestra-table__cell">15% de consumo de datos</span>
          <span class="alestra-table__cell">5GB de capacidad total</span>
          <span class="alestra-table__cell alestra-table__cell--sm alestra-table__cell--actions">
            <span class="alestra-accordion__chevron">›</span>
          </span>
        </button>
        <div class="alestra-accordion__content alestra-table__row-detail">
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap;padding:0.75rem 1rem;">
            <a href="<%= gestion_bloqueo_root_path %>" class="alestra-btn-primary alestra-btn--small">Bloquear línea</a>
            <a href="<%= gestion_desbloqueo_root_path %>" class="alestra-btn-secondary alestra-btn--small">Desbloquear línea</a>
            <a href="<%= gestion_bloqueo_equipo_root_path %>" class="alestra-btn-secondary alestra-btn--small">Bloquear equipo</a>
            <a href="<%= gestion_productos_root_path %>" class="alestra-btn-secondary alestra-btn--small">Agregar producto</a>
            <a href="<%= gestion_plan_root_path %>" class="alestra-btn-secondary alestra-btn--small">Cambiar plan</a>
            <a href="<%= gestion_sim_reemplazo_path %>" class="alestra-btn-secondary alestra-btn--small">Reemplazar SIM</a>
            <a href="<%= gestion_limite_consumo_root_path %>" class="alestra-btn-secondary alestra-btn--small">Límite de consumo</a>
            <a href="<%= gestion_baja_linea_root_path %>" class="alestra-btn-secondary alestra-btn--small alestra-btn--danger">Baja de línea</a>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="alestra-table__pagination">
    <span class="alestra-table__pagination-info">1-10 de 2823 resultados</span>
    <nav class="alestra-pagination" aria-label="Paginación">
      <button class="alestra-pagination__btn" aria-label="Anterior">‹</button>
      <button class="alestra-pagination__btn alestra-pagination__btn--active">1</button>
      <button class="alestra-pagination__btn">2</button>
      <button class="alestra-pagination__btn">3</button>
      <span class="alestra-pagination__ellipsis">...</span>
      <button class="alestra-pagination__btn">283</button>
      <button class="alestra-pagination__btn" aria-label="Siguiente">›</button>
    </nav>
  </div>
</div>
