<% content_for :topbar_right do %>
  <a href="<%= gestion_root_path %>" class="alestra-btn-secondary alestra-btn--small">Volver a líneas</a>
<% end %>

<h1 class="alestra-page-title">Gestión de líneas y servicios</h1>
<div class="alestra-gestion-tabla">
  <div class="alestra-table">
    <div class="alestra-table__header alestra-gestion-table-header">
      <span class="alestra-table__cell"># de línea</span>
      <span class="alestra-table__cell alestra-table__cell--sm">Estatus</span>
      <span class="alestra-table__cell">Usuario</span>
      <span class="alestra-table__cell">Tipo de plan</span>
      <span class="alestra-table__cell">% de consumo</span>
      <span class="alestra-table__cell">Capacidad total</span>
      <span class="alestra-table__cell alestra-table__cell--sm"></span>
    </div>
    <% 8.times do %>
      <div class="alestra-table__row">
        <span class="alestra-table__cell">618 382 5441</span>
        <span class="alestra-table__cell alestra-table__cell--sm">
          <span class="alestra-badge alestra-badge--active">Activo</span>
        </span>
        <span class="alestra-table__cell">Jon Snow</span>
        <span class="alestra-table__cell">Cobertura Completa 3.5 GB_Control</span>
        <span class="alestra-table__cell">15% de consumo de datos</span>
        <span class="alestra-table__cell">5GB de capacidad total</span>
        <span class="alestra-table__cell alestra-table__cell--sm alestra-table__cell--actions">›</span>
      </div>
    <% end %>
  </div>
</div>

<turbo-frame id="modal_frame">
  <div class="alestra-modal-backdrop" data-controller="alestra--modal" data-alestra--modal-open-value="true">
    <div class="alestra-modal" role="dialog" aria-modal="true">
      <div class="alestra-modal__header">
        <h2 class="alestra-modal__title">Desbloqueo de equipo</h2>
        <a href="<%= gestion_root_path %>" class="alestra-modal__close" aria-label="Cerrar">×</a>
      </div>
      <div class="alestra-modal__body">
        <p>Ingresa los datos del equipo que deseas desbloquear.</p>
        <div class="alestra-form-grid alestra-form-grid--2col" style="margin-top:1rem;">
          <div class="alestra-form-group">
            <label class="alestra-label" for="deseq_marca">Marca*</label>
            <input class="alestra-input" type="text" id="deseq_marca" placeholder="SAMSUNG">
          </div>
          <div class="alestra-form-group">
            <label class="alestra-label" for="deseq_modelo">Modelo*</label>
            <input class="alestra-input" type="text" id="deseq_modelo" placeholder="Galaxy S25">
          </div>
          <div class="alestra-form-group">
            <label class="alestra-label" for="deseq_imei">IMEI*</label>
            <input class="alestra-input" type="text" id="deseq_imei" placeholder="354723091234567">
          </div>
          <div class="alestra-form-group">
            <label class="alestra-label" for="deseq_comentarios">Comentarios</label>
            <input class="alestra-input" type="text" id="deseq_comentarios" placeholder="Escribe un comentario">
          </div>
        </div>
      </div>
      <div class="alestra-modal__footer">
        <a href="<%= gestion_root_path %>" class="alestra-btn-secondary">Cancelar</a>
        <a href="<%= gestion_desbloqueo_equipo_confirmar_path %>" class="alestra-btn-primary">Continuar</a>
      </div>
    </div>
  </div>
</turbo-frame>
